# Базаи маълумот (PostgreSQL)
# Ташриф дар Render / Neon / Supabase / Railway
DATABASE_URL="postgresql://user:pass@localhost:5432/tambola90"

# JWT
JWT_SECRET="change_me_to_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# SMS: eskiz / sms_gateway / stub
SMS_API_KEY=""
SMS_PROVIDER="sms_gateway"

# SMS Gateway — маълумоти сервери дохилӣ
SMS_GATEWAY_TOKEN=""
SMS_GATEWAY_URL="https://api.sms-gate.app:443/api/v1/send-sms"

# Сервер
PORT=10000
UPLOAD_PATH="./uploads"

# CORS
CORS_ORIGIN="*"
