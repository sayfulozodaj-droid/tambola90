# Базаи маълумот (PostgreSQL)
# Шумо метавонед URL-и дурдастро истифода баред (Neon, Supabase, Railway...)
DATABASE_URL="postgresql://user:pass@localhost:5432/tambola90"

# JWT
JWT_SECRET="change_me_to_long_random_string"
JWT_EXPIRES_IN="7d"

# SMS: eskiz / sms_gateway / stub
SMS_API_KEY=""
SMS_PROVIDER="stub"
# Барои SMS Gateway:
# SMS_GATEWAY_TOKEN="your_token_here"
# SMS_GATEWAY_URL="https://api.sms-gateway.tj/v1/send"

# Сервер
PORT=3000
UPLOAD_PATH="./uploads"

# CORS (Android app барои HTTP лозим нест, аммо барои web-client)
CORS_ORIGIN="*"
